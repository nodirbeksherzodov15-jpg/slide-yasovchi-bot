# Haqiqiy qiymatlarni GitHub'ga YOZMANG. Ularni hostingdagi Environment Variables bo'limiga kiriting.

# Majburiy: @BotFather bergan token
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Ixtiyoriy: Google AI Studio (Gemini) API kaliti. Bo'lsa, matnlar AI yordamida yoziladi.
# Bo'lmasa, bot oddiy (namunaviy) matn bilan ishlaydi.
GEMINI_API_KEY=

# Ixtiyoriy: model nomi (Google modellari o'zgarib turadi, kerak bo'lsa yangilang)
GEMINI_MODEL=gemini-2.5-flash

# Ixtiyoriy: 0 qo'ysangiz, bot o'zini-o'zi "uyg'otib" turmaydi
KEEPALIVE=1

# Ixtiyoriy: bir vaqtda nechta taqdimot yaratilsin (bepul hostingda 1-2 yetarli)
MAX_PARALLEL=2
